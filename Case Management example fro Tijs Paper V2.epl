select pred.pmID, pred.caseID, "Hold meeting", 
case when pred.state="completed" and  evaluate(CV.variables, "nextAction=hold") = true then "started" else "skipped" end,
CV.variables, pred.timestamp
From ProcessEvent as pred join Case_Variables as CV on pred.pmID = CV.pmID and pred.caseID = CV.caseID
